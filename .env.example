# 复制为 .env 或在 shell 中设置

# GitHub（挖链/矿工强烈建议配置；无 token 每小时仅 60 次 API）
# 创建：https://github.com/settings/tokens （repo 公开读即可，classic: public_repo）
GITHUB_TOKEN=
# 也可把 token 单独放进 data/github_token.txt（一行）

# 云端 OpenAI 兼容（论坛 cleaner_forum.py 用）
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# 本地 Ollama（link_curator / commercial_pipeline / ai_cleaner）
OLLAMA_BASE_URL=http://localhost:11434
# 建议本机已拉取的最大可用模型；留空时自动选本机最强 qwen/llama
OLLAMA_MODEL=qwen2.5:7b
# 单次 chat 超时（秒）。管线用 PIPELINE_OLLAMA_TIMEOUT，暂停更灵敏
OLLAMA_TIMEOUT=120
PIPELINE_OLLAMA_TIMEOUT=25

# Cloudflare Pages（管理台 Sync to Cloudflare / sync_catalog.py --deploy）
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_PAGES_PROJECT=drvvault
# 可选：覆盖整条部署命令（跳过内置 npm build + wrangler）
# CF_DEPLOY_CMD=
